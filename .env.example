VITE_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token
TMDB_ACCESS_TOKEN=your_tmdb_server_read_access_token
IGDB_CLIENT_ID=your_twitch_application_client_id
IGDB_CLIENT_SECRET=your_twitch_application_client_secret
FANART_TV_API_KEY=your_fanart_tv_personal_api_key
LASTFM_API_KEY=your_lastfm_api_key
VITE_APP_CONTACT=you@example.com

# Firebase Authentication and Firestore configuration (no paid Storage required)
# Enable Email/Password auth and create one Firestore database on the free Spark plan.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_PERSONALIZED_HOME_FEED=true

# Server-only clean verification links (Gmail SMTP example)
APP_BASE_URL=https://your-public-app-domain.example
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM=The Commonplace <your-sender@gmail.com>
